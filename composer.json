{
    "name": "ilbronza/schedules",
    "description": "schedules and deadlines for laravel",
    "license": "MIT",
    "authors": [
        {
            "name": "Davide Bronzini",
            "email": "davide_bronzini@hotmail.com",
            "homepage": "https://sistema.srl"
        }
    ],
    "homepage": "https://github.com/ilbronza/schedules",
    "keywords": ["Laravel", "Schedules"],
    "require": {
    },
    "require-dev": {
        "orchestra/testbench": "^9.0 || ^10.0"
    },
    "suggest": {
        "ilbronza/filecabinet": "Enables the legacy Dossierrow expiration-date integration"
    },
    "scripts": {
        "test": "phpunit"
    },
    "autoload": {
        "psr-4": {
            "IlBronza\\Schedules\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "IlBronza\\Schedules\\Tests\\": "tests",
            "App\\": "tests/Fixtures/App/app"
        },
        "files": [
            "tests/helpers.php"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "IlBronza\\Schedules\\SchedulesServiceProvider"
            ],
            "aliases": {
                "Schedules": "IlBronza\\Schedules\\Facades\\Schedules"
            }
        }
    }
}
